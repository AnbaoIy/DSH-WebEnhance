{
  "name": "dsh-webenhance",
  "version": "0.1.0",
  "description": "DSH-WebEnhance: route web_search to Parallel and web_fetch to Tavily, escalating to Firecrawl when Tavily is out of quota, blocked by anti-bot, or returns no usable content.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": {
      "default": "./lib/client.js"
    }
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "cordis-plugin",
    "web-search",
    "web-fetch",
    "parallel",
    "tavily",
    "firecrawl"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-credentials": "*",
    "@deepseek-ai/dsh-launch-environment": "*",
    "@deepseek-ai/dsh-web": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "scripts": {
    "pretest": "node tools/make-shims.mjs",
    "test": "node --test --test-isolation=none \"test/**/*.test.mjs\""
  }
}
